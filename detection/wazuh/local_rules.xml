<!--
  Custom rules for the lab. Copy to /var/ossec/etc/rules/local_rules.xml on the WAZUH MANAGER,
  then: sudo systemctl restart wazuh-manager
  Test without restarting: /var/ossec/bin/wazuh-logtest  (paste one line of audit.log)
  Lab rule IDs: 100100-100109 = ModSecurity / WAF, 100110-100119 = Suricata
  SSH brute force is covered by Wazuh's built-in rules (5760 failed login, 5763 brute force).
-->
<group name="modsecurity,web,attack,">

  <!-- Base: any ModSecurity JSON audit entry -->
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="transaction.client_ip">\.+</field>
    <field name="transaction.request.uri">\.+</field>
    <description>ModSecurity: audit event from $(transaction.client_ip)</description>
  </rule>

  <!-- Request blocked by the WAF (CRS anomaly threshold reached) -->
  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="transaction.response.http_code">^403$</field>
    <description>ModSecurity: blocked request from $(transaction.client_ip) to $(transaction.request.uri)</description>
    <group>waf_block,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- SQL injection (CRS 942xxx) -->
  <rule id="100102" level="12">
    <if_sid>100101</if_sid>
    <match>"ruleId":"942</match>
    <description>ModSecurity: SQL injection blocked from $(transaction.client_ip)</description>
    <group>waf_block,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- Many blocks from one IP in a short time = automated attack tool (sqlmap, nikto, ...) -->
  <rule id="100103" level="13" frequency="10" timeframe="60">
    <if_matched_group>waf_block</if_matched_group>
    <same_field>transaction.client_ip</same_field>
    <description>ModSecurity: 10+ blocked requests in 60s from $(transaction.client_ip) (automated attack)</description>
    <mitre>
      <id>T1190</id>
      <id>T1595</id>
    </mitre>
  </rule>

  <!-- Failed Juice Shop login -->
  <rule id="100104" level="5">
    <if_sid>100100</if_sid>
    <field name="transaction.request.uri">^/rest/user/login</field>
    <field name="transaction.response.http_code">^401$</field>
    <description>Juice Shop: failed login from $(transaction.client_ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Login brute force (hydra) -->
  <rule id="100105" level="12" frequency="10" timeframe="60">
    <if_matched_sid>100104</if_matched_sid>
    <same_field>transaction.client_ip</same_field>
    <description>Juice Shop: login brute force, 10+ failures in 60s from $(transaction.client_ip)</description>
    <group>authentication_failures,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>

<group name="suricata,ids,">

  <!-- Built-in rule 86601 = any Suricata alert; this narrows it to ET SCAN signatures -->
  <rule id="100110" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature">^ET SCAN|^GPL SCAN</field>
    <description>Suricata: scan activity from $(src_ip): $(alert.signature)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- Several scan signatures from one IP = port scan -->
  <rule id="100111" level="12" frequency="4" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Suricata: port scan from $(src_ip) (4+ scan alerts in 60s)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

</group>

<!-- Phase 5: verdicts from the ML scoring service (ml/service), shipped from /var/lib/lab-ml/data/ml-alerts.json -->
<group name="ml,lab_ml,">

  <rule id="100120" level="5">
    <decoded_as>json</decoded_as>
    <field name="event_source">^lab-ml$</field>
    <field name="ml.verdict">^anomaly$</field>
    <description>ML: anomalous request from $(src_ip) to $(http.url) (score $(ml.anomaly_score))</description>
    <group>ml_detection,</group>
  </rule>

  <rule id="100121" level="10">
    <decoded_as>json</decoded_as>
    <field name="event_source">^lab-ml$</field>
    <field name="ml.verdict">^attack$</field>
    <description>ML: request from $(src_ip) classified as $(ml.predicted_class) (p=$(ml.attack_proba))</description>
    <group>ml_detection,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- The case this layer exists for: the model flags it, the WAF signatures let it through -->
  <rule id="100122" level="12">
    <if_sid>100121</if_sid>
    <field name="waf_blocked">^false$</field>
    <description>ML: suspicious request from $(src_ip) NOT blocked by the WAF: $(http.http_method) $(http.url)</description>
    <group>ml_detection,</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100123" level="12" frequency="5" timeframe="60">
    <if_matched_group>ml_detection</if_matched_group>
    <same_field>src_ip</same_field>
    <description>ML: 5+ suspicious requests in 60s from $(src_ip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

</group>
