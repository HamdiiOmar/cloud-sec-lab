<!--
  Phase 4: add inside <ossec_config> in /var/ossec/etc/ossec.conf on the WAZUH MANAGER,
  then: sudo systemctl restart wazuh-manager
-->

<!-- Active Response command Shuffle triggers through the Wazuh API (PUT /active-response, command "lab-block").
     Runs /var/ossec/active-response/bin/lab-block.sh on the agent. No <active-response> block:
     nothing blocks automatically, Shuffle decides. -->
<command>
  <name>lab-block</name>
  <executable>lab-block.sh</executable>
  <timeout_allowed>no</timeout_allowed>
</command>

<!-- Forward correlation alerts to the Shuffle webhook (Wazuh's built-in "shuffle" integration).
     Only the aggregated rules, not every single WAF block: one sqlmap run is ~170 alerts.
     100103 automated web attack, 100105 login brute force, 100111 port scan, 5763 SSH brute force.
     Replace the hook_url with the one printed by soar/shuffle/build_workflow.py. -->
<integration>
  <name>shuffle</name>
  <hook_url>http://192.168.56.1:5001/api/v1/hooks/webhook_REPLACE_ME</hook_url>
  <rule_id>100103,100105,100111,5763</rule_id>
  <alert_format>json</alert_format>
</integration>
