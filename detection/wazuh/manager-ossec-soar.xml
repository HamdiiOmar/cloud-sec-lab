<!-- No <command> block needed: Shuffle calls the Wazuh API with command "!lab-block.sh", which runs
     /var/ossec/active-response/bin/lab-block.sh on the agent directly. (A named command only works through
     the API when it also has an <active-response> block, which would make Wazuh block on its own.) -->

<!-- Forward correlation alerts to the Shuffle webhook (Wazuh's built-in "shuffle" integration).
     Only the aggregated rules, not every single WAF block: one sqlmap run is ~170 alerts.
     100103 automated web attack, 100105 login brute force, 100111 port scan, 5763 SSH brute force.
     Replace the hook_url with the one printed by soar/shuffle/build_workflow.py. -->
<integration>
  <name>shuffle</name>
  <hook_url>http://192.168.56.1:5001/api/v1/hooks/webhook_REPLACE_ME</hook_url>
  <rule_id>100103,100105,100111,5763</rule_id>
  <alert_format>json</alert_format>
</integration>
